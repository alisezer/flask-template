# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.

# development | testing | production
APP_ENV=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Defaults to a local SQLite file (stories.db). For Postgres:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/stories

LOG_LEVEL=INFO

# Docker Compose only
POSTGRES_PASSWORD=stories
